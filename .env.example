# Copy to .env.local for development; set these in the Vercel project's
# Environment Variables for production/preview. Nothing here is set yet —
# the lead form works without any of them (it logs to console and returns
# success), but leads aren't durably captured until DATABASE_URL is set.

# Postgres connection string for lead storage (src/lib/db.ts). Any standard
# Postgres works — pick one, no other code change needed:
#   - Vercel Postgres: Vercel dashboard → Storage → Create Database → Postgres
#     → it auto-populates a POSTGRES_URL var; copy that value in here as
#     DATABASE_URL (or rename the var in db.ts to match).
#   - Neon (https://neon.tech): free tier, Postgres-compatible, gives you a
#     connection string on project creation.
#   - Supabase (https://supabase.com): free tier, connection string under
#     Project Settings → Database.
# Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=

# Resend API key for lead notification emails (src/lib/email.ts). Sign up
# free at https://resend.com, then API Keys → Create API Key.
RESEND_API_KEY=

# Optional: who receives the lead notification email. Defaults to SITE.email
# (src/data/site.ts) if unset.
LEAD_NOTIFY_EMAIL=

# Optional: the Resend "From" address. Defaults to Resend's no-verification
# sandbox sender (onboarding@resend.dev), which only delivers to the Resend
# account's own owner. Once a real domain is registered and verified with
# Resend, set this to an address on that domain to send to anyone.
RESEND_FROM_EMAIL=
